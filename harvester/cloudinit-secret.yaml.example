# Copy to cloudinit-secret.yaml, fill token + SSH key, then:
#   kubectl -n default create secret generic voxbox-cloudinit \
#     --from-file=userdata=user-data.yaml \
#     --from-file=networkdata=network-data.yaml
#
# Or apply a Secret whose keys are `userdata` and `networkdata` (Harvester/KubeVirt cloudInitNoCloud secretRef).
apiVersion: v1
kind: Secret
metadata:
  name: voxbox-cloudinit
  namespace: default
type: Opaque
stringData:
  userdata: |
    # Paste contents of user-data.yaml here (with real ssh key + Gitea token)
  networkdata: |
    # Paste contents of network-data.yaml here
